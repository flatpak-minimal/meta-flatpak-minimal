+/* Read every keyring the verifier was given: the keyring files, the keyring
+ * data and the ASCII key files, in that order. */
+static gboolean
+_ostree_gpg_verifier_load_keyrings (OstreeGpgVerifier *self, GPtrArray **out_keyrings,
+                                    GCancellable *cancellable, GError **error)
+{
+  g_autoptr (GPtrArray) keyrings = g_ptr_array_new_with_free_func ((GDestroyNotify)g_bytes_unref);
+
+  for (GList *link = self->keyrings; link != NULL; link = link->next)
+    {
+      GFile *keyring_file = link->data;
+      g_autoptr (GError) local_error = NULL;
+      g_autoptr (GBytes) bytes = g_file_load_bytes (keyring_file, cancellable, NULL, &local_error);
+
+      if (bytes == NULL)
+        {
+          /* Disregard non-existent keyrings. */
+          if (g_error_matches (local_error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND))
+            continue;
+          g_propagate_error (error, g_steal_pointer (&local_error));
+          return FALSE;
+        }
+
+      g_ptr_array_add (keyrings, g_steal_pointer (&bytes));
+    }
+
+  for (guint i = 0; i < self->keyring_data->len; i++)
+    g_ptr_array_add (keyrings, g_bytes_ref (self->keyring_data->pdata[i]));
+
+  if (self->key_ascii_files)
+    {
+      for (guint i = 0; i < self->key_ascii_files->len; i++)
+        {
+          const char *path = self->key_ascii_files->pdata[i];
+          glnx_autofd int fd = -1;
+
+          if (!glnx_openat_rdonly (AT_FDCWD, path, TRUE, &fd, error))
+            return FALSE;
+
+          g_autoptr (GBytes) bytes = glnx_fd_readall_bytes (fd, cancellable, error);
+          if (bytes == NULL)
+            return FALSE;
+
+          g_ptr_array_add (keyrings, g_steal_pointer (&bytes));
+        }
+    }
+
+  *out_keyrings = g_steal_pointer (&keyrings);
+  return TRUE;
+}
+
+gboolean
+_ostree_gpg_verifier_list_keys (OstreeGpgVerifier *self, const char *const *key_ids,
+                                GPtrArray **out_keys, GCancellable *cancellable, GError **error)
+{
+  return glnx_throw (error, "GPG: Listing keys is not supported with Sequoia");
+}
+
+OstreeGpgVerifyResult *
+_ostree_gpg_verifier_check_signature (OstreeGpgVerifier *self, GBytes *signed_data,
+                                      GBytes *signatures, GCancellable *cancellable, GError **error)
+{
+  GLNX_AUTO_PREFIX_ERROR ("GPG", error);
+
+  if (g_cancellable_set_error_if_cancelled (cancellable, error))
+    return NULL;
+
+  g_autoptr (GPtrArray) keyrings = NULL;
+  if (!_ostree_gpg_verifier_load_keyrings (self, &keyrings, cancellable, error))
+    return NULL;
+
+  g_autofree OpvBuffer *buffers = g_new0 (OpvBuffer, keyrings->len + 1);
+  for (guint i = 0; i < keyrings->len; i++)
+    buffers[i].data = g_bytes_get_data (keyrings->pdata[i], &buffers[i].len);
+
+  OstreeGpgVerifyResult *result
+      = g_initable_new (OSTREE_TYPE_GPG_VERIFY_RESULT, cancellable, error, NULL);
+  if (result == NULL)
+    return NULL;
+
+  gsize data_len;
+  const guint8 *data = g_bytes_get_data (signed_data, &data_len);
+  gsize signatures_len;
+  const guint8 *signatures_data = g_bytes_get_data (signatures, &signatures_len);
+  char *message = NULL;
+
+  if (opv_verify (buffers, keyrings->len, data, data_len, signatures_data, signatures_len,
+                     &result->signatures, &result->n_signatures, &message)
+      != 0)
+    {
+      glnx_throw (error, "%s", message ?: "Unable to complete signature verification");
+      opv_string_free (message);
+      g_object_unref (result);
+      return NULL;
+    }
+
+  return result;
+}
+
+#endif /* OSTREE_GPG_SEQUOIA */
