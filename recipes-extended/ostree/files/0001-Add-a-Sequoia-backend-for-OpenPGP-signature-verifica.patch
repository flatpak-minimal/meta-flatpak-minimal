+#ifdef OSTREE_GPG_SEQUOIA
+/* ostree_repo_remote_gpg_import() without gpg: merge the keys into the
+ * remote's keyring file directly. */
+static gboolean
+remote_gpg_import_sequoia (OstreeRepo *self, const char *name, GInputStream *source_stream,
+                           const char *const *key_ids, guint *out_imported,
+                           GCancellable *cancellable, GError **error)
+{
+  GLNX_AUTO_PREFIX_ERROR ("GPG", error);
+
+  g_return_val_if_fail (OSTREE_IS_REPO (self), FALSE);
+  g_return_val_if_fail (name != NULL, FALSE);
+
+  /* gpg read the user's own keyring here; without gpg there is none. */
+  if (source_stream == NULL)
+    return glnx_throw (error, "Importing from the user's keyring is not supported with Sequoia");
+
+  /* First make sure the remote name is valid. */
+  OstreeRemote *remote = _ostree_repo_get_remote_inherited (self, name, error);
+  if (remote == NULL)
+    return FALSE;
+  g_autofree char *keyring_path = g_strdup (remote->keyring);
+  ostree_remote_unref (remote);
+
+  g_autoptr (GOutputStream) source_out = g_memory_output_stream_new_resizable ();
+  if (g_output_stream_splice (source_out, source_stream, G_OUTPUT_STREAM_SPLICE_CLOSE_TARGET,
+                              cancellable, error)
+      < 0)
+    return FALSE;
+  g_autoptr (GBytes) source
+      = g_memory_output_stream_steal_as_bytes (G_MEMORY_OUTPUT_STREAM (source_out));
+
+  g_autoptr (GBytes) keyring = NULL;
+  glnx_autofd int fd = -1;
+  if (!ot_openat_ignore_enoent (self->repo_dir_fd, keyring_path, &fd, error))
+    return glnx_prefix_error (error, "Unable to read remote's keyring");
+  if (fd >= 0)
+    {
+      keyring = glnx_fd_readall_bytes (fd, cancellable, error);
+      if (keyring == NULL)
+        return glnx_prefix_error (error, "Unable to read remote's keyring");
+    }
+
+  gsize keyring_len = 0;
+  const guint8 *keyring_data = keyring ? g_bytes_get_data (keyring, &keyring_len) : NULL;
+  gsize source_len;
+  const guint8 *source_data = g_bytes_get_data (source, &source_len);
+  guint8 *new_keyring = NULL;
+  gsize new_keyring_len = 0;
+  unsigned int imported = 0;
+  char *message = NULL;
+
+  if (opv_keyring_import (keyring_data, keyring_len, source_data, source_len, key_ids,
+                             &new_keyring, &new_keyring_len, &imported, &message)
+      != 0)
+    {
+      glnx_throw (error, "%s", message ?: "Unable to import keys");
+      opv_string_free (message);
+      return FALSE;
+    }
+
+  /* All imports were successful; replace the remote's old keyring. */
+  gboolean replaced = glnx_file_replace_contents_at (self->repo_dir_fd, keyring_path, new_keyring,
+                                                     new_keyring_len, 0, cancellable, error);
+  opv_bytes_free (new_keyring, new_keyring_len);
+  if (!replaced)
+    return FALSE;
+
+  if (out_imported != NULL)
+    *out_imported = imported;
+
+  return TRUE;
+}
+#endif /* OSTREE_GPG_SEQUOIA */
+
