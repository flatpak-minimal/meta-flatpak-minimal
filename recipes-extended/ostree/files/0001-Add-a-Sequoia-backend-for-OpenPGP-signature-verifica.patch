+static void
+ostree_gpg_verify_result_finalize (GObject *object)
+{
+  OstreeGpgVerifyResult *result = OSTREE_GPG_VERIFY_RESULT (object);
+
+  opv_signatures_free (result->signatures, result->n_signatures);
+
+  G_OBJECT_CLASS (ostree_gpg_verify_result_parent_class)->finalize (object);
+}
+
+static gboolean
+ostree_gpg_verify_result_initable_init (GInitable *initable, GCancellable *cancellable,
+                                        GError **error)
+{
+  return TRUE;
+}
+
+static void
+ostree_gpg_verify_result_class_init (OstreeGpgVerifyResultClass *class)
+{
+  GObjectClass *object_class;
+
+  object_class = G_OBJECT_CLASS (class);
+  object_class->finalize = ostree_gpg_verify_result_finalize;
+}
+
+static void
+ostree_gpg_verify_result_init (OstreeGpgVerifyResult *result)
+{
+}
+
+static void
+ostree_gpg_verify_result_initable_iface_init (GInitableIface *iface)
+{
+  iface->init = ostree_gpg_verify_result_initable_init;
+}
+
+guint
+ostree_gpg_verify_result_count_all (OstreeGpgVerifyResult *result)
+{
+  g_return_val_if_fail (OSTREE_IS_GPG_VERIFY_RESULT (result), 0);
+
+  return (guint)result->n_signatures;
+}
+
+guint
+ostree_gpg_verify_result_count_valid (OstreeGpgVerifyResult *result)
+{
+  guint count = 0;
+
+  g_return_val_if_fail (OSTREE_IS_GPG_VERIFY_RESULT (result), 0);
+
+  for (size_t i = 0; i < result->n_signatures; i++)
+    {
+      if (result->signatures[i].valid)
+        count++;
+    }
+
+  return count;
+}
+
+gboolean
+ostree_gpg_verify_result_lookup (OstreeGpgVerifyResult *result, const gchar *key_id,
+                                 guint *out_signature_index)
+{
+  g_return_val_if_fail (OSTREE_IS_GPG_VERIFY_RESULT (result), FALSE);
+  g_return_val_if_fail (key_id != NULL, FALSE);
+
+  /* As gpg takes it: a key ID or a fingerprint, of the primary key or of
+   * any subkey of the certificate that signed. */
+  if (g_str_has_prefix (key_id, "0x") || g_str_has_prefix (key_id, "0X"))
+    key_id += 2;
+  g_autofree char *id = g_ascii_strup (key_id, -1);
+  if (strlen (id) < 8)
+    return FALSE;
+
+  for (size_t i = 0; i < result->n_signatures; i++)
+    {
+      const OpvSignature *signature = &result->signatures[i];
+
+      if (signature->cert_fingerprints == NULL)
+        continue;
+
+      g_auto (GStrv) fingerprints = g_strsplit (signature->cert_fingerprints, " ", -1);
+      for (char **fpr = fingerprints; *fpr != NULL; fpr++)
+        {
+          if (**fpr != '\0' && g_str_has_suffix (*fpr, id))
+            {
+              if (out_signature_index != NULL)
+                *out_signature_index = (guint)i;
+              /* Note early return */
+              return TRUE;
+            }
+        }
+    }
+
+  return FALSE;
+}
+
+GVariant *
+ostree_gpg_verify_result_get (OstreeGpgVerifyResult *result, guint signature_index,
+                              OstreeGpgSignatureAttr *attrs, guint n_attrs)
+{
+  GVariantBuilder builder;
+
+  g_return_val_if_fail (OSTREE_IS_GPG_VERIFY_RESULT (result), NULL);
+  g_return_val_if_fail (attrs != NULL, NULL);
+  g_return_val_if_fail (n_attrs > 0, NULL);
+  g_return_val_if_fail (signature_index < result->n_signatures, NULL);
+
+  const OpvSignature *signature = &result->signatures[signature_index];
+
+  g_variant_builder_init (&builder, G_VARIANT_TYPE_TUPLE);
+
+  for (guint ii = 0; ii < n_attrs; ii++)
+    {
+      GVariant *child;
+
+      switch (attrs[ii])
+        {
+        case OSTREE_GPG_SIGNATURE_ATTR_VALID:
+          child = g_variant_new_boolean (signature->valid != 0);
+          break;
+
+        case OSTREE_GPG_SIGNATURE_ATTR_SIG_EXPIRED:
+          child = g_variant_new_boolean (signature->sig_expired != 0);
+          break;
+
+        case OSTREE_GPG_SIGNATURE_ATTR_KEY_EXPIRED:
+          child = g_variant_new_boolean (signature->key_expired != 0);
+          break;
+
+        case OSTREE_GPG_SIGNATURE_ATTR_KEY_REVOKED:
+          child = g_variant_new_boolean (signature->key_revoked != 0);
+          break;
+
+        case OSTREE_GPG_SIGNATURE_ATTR_KEY_MISSING:
+          child = g_variant_new_boolean (signature->key_missing != 0);
+          break;
+
+        case OSTREE_GPG_SIGNATURE_ATTR_FINGERPRINT:
+          child = g_variant_new_string (signature->fingerprint ?: "");
+          break;
+
+        case OSTREE_GPG_SIGNATURE_ATTR_TIMESTAMP:
+          child = g_variant_new_int64 (signature->timestamp);
+          break;
+
+        case OSTREE_GPG_SIGNATURE_ATTR_EXP_TIMESTAMP:
+          child = g_variant_new_int64 (signature->exp_timestamp);
+          break;
+
+        case OSTREE_GPG_SIGNATURE_ATTR_PUBKEY_ALGO_NAME:
+          child = g_variant_new_string (signature->pubkey_algo_name ?: "[unknown name]");
+          break;
+
+        case OSTREE_GPG_SIGNATURE_ATTR_HASH_ALGO_NAME:
+          child = g_variant_new_string (signature->hash_algo_name ?: "[unknown name]");
+          break;
+
+        case OSTREE_GPG_SIGNATURE_ATTR_USER_NAME:
+          child = g_variant_new_string (signature->user_name ?: "[unknown name]");
+          break;
+
+        case OSTREE_GPG_SIGNATURE_ATTR_USER_EMAIL:
+          child = g_variant_new_string (signature->user_email ?: "[unknown email]");
+          break;
+
+        case OSTREE_GPG_SIGNATURE_ATTR_FINGERPRINT_PRIMARY:
+          child = g_variant_new_string (signature->fingerprint_primary ?: "");
+          break;
+
+        case OSTREE_GPG_SIGNATURE_ATTR_KEY_EXP_TIMESTAMP:
+          child = g_variant_new_int64 (signature->key_exp_timestamp);
+          break;
+
+        case OSTREE_GPG_SIGNATURE_ATTR_KEY_EXP_TIMESTAMP_PRIMARY:
+          child = g_variant_new_int64 (signature->key_exp_timestamp_primary);
+          break;
+
+        default:
+          g_critical ("Invalid signature attribute (%d)", attrs[ii]);
+          g_variant_builder_clear (&builder);
+          return NULL;
+        }
+
+      g_variant_builder_add_value (&builder, child);
+    }
+
+  return g_variant_builder_end (&builder);
+}
+
+#endif /* OSTREE_GPG_SEQUOIA */
