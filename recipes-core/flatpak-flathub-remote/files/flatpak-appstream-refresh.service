[Unit]
Description=Refresh the Flathub AppStream data for @FLATPAK_MINIMAL_USER@
After=flatpak-add-flathub-remote.service flatpak-install-remote-manager.service network-online.target
Wants=network-online.target

[Service]
Type=exec
User=@FLATPAK_MINIMAL_USER@
Group=@FLATPAK_MINIMAL_USER@
RuntimeMaxSec=15min
ExecStart=/usr/bin/flatpak update --appstream --user flathub

[Install]
WantedBy=multi-user.target
