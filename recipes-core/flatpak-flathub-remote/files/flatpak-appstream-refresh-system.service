[Unit]
Description=Refresh the Flathub AppStream data (system-wide)
After=flatpak-add-flathub-remote-system.service network-online.target
Wants=network-online.target

[Service]
Type=exec
RuntimeMaxSec=15min
ExecStart=/usr/bin/flatpak update --appstream --system flathub

[Install]
WantedBy=multi-user.target
